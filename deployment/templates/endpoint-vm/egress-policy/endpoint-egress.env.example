# Copy to a root-owned file outside the repository and review every value.
# This file contains topology and identity metadata, never Provider credentials.
AGENTDLP_AGENT_UID=1000
# P1 preferred enforcement scope; emitted by bpf_get_current_cgroup_id().
# Leave empty only during the temporary UID compatibility phase.
AGENTDLP_WORKLOAD_CGROUP_ID=
# Recorded and validated as workload identity; nftables has no portable netns-inode match.
AGENTDLP_WORKLOAD_NETNS_INODE=
AGENTDLP_AGENT_IFACE=eth1
AGENTDLP_MANAGEMENT_IFACE=eth0
AGENTDLP_MANAGEMENT_CIDR=172.22.112.0/20
AGENTDLP_GATEWAY_IPV4=192.168.10.1
AGENTDLP_PROXY_PORT=8080
AGENTDLP_DNS_PORT=53
# Set to 18080 only while the controlled redirect relay is deployed.
# Direct External destinations remain denied by the final UID rule.
AGENTDLP_REDIRECT_PORT=18080
# Persistent synthetic remote MCP is reachable only through this fixed
# Gateway listener. Set to 0 when that capability is intentionally disabled.
AGENTDLP_REMOTE_MCP_PORT=18182
AGENTDLP_ROLLBACK_SECONDS=600
AGENTDLP_WORKSPACE=/home/zhang/agentdlp/workspaces/proxy-bypass
