# Copy to a root-owned file outside the repository and review every value.
# This file contains topology and allowlist metadata, never Provider credentials.
AGENTDLP_GATEWAY_AGENT_IFACE=eth1
AGENTDLP_GATEWAY_EGRESS_IFACE=eth2
AGENTDLP_GATEWAY_MANAGEMENT_IFACE=eth0
AGENTDLP_GATEWAY_AGENT_CIDR=192.168.10.0/24
AGENTDLP_GATEWAY_MANAGEMENT_CIDR=172.22.112.0/20
AGENTDLP_GATEWAY_DOCKER_CIDR=172.18.0.0/16
AGENTDLP_GATEWAY_PROXY_PORT=8080
AGENTDLP_GATEWAY_DNS_PORT=53
# Dedicated fixed-upstream relay used only by the controlled eBPF redirect.
# Set to 0 when the redirect experiment is not deployed.
AGENTDLP_GATEWAY_CONTROLLED_REDIRECT_PORT=18080
# Persistent, fixed-upstream synthetic remote-MCP relay.  Set both values to
# 0/empty when this capability is intentionally not deployed.
AGENTDLP_GATEWAY_REMOTE_MCP_PORT=18182
AGENTDLP_GATEWAY_REMOTE_MCP_UPSTREAM=192.168.20.10:8811
AGENTDLP_GATEWAY_MANAGEMENT_SSH_PORT=22
AGENTDLP_GATEWAY_ROLLBACK_SECONDS=600

# Host dnsmasq upstreams. Add only reviewed resolver IPs.
AGENTDLP_GATEWAY_UPSTREAM_DNS=172.22.112.1

# First P1-lite allowlist: the project-owned External VM services used by the
# controlled experiments. Add public Provider IPs only from the experiment DNS
# evidence window when running real Provider cases.
AGENTDLP_GATEWAY_ALLOWED_UPSTREAMS=192.168.20.10:8000,192.168.20.10:8443

# Empty by default: Endpoint must not route directly through Gateway to External.
# Use only for a short, reviewed contrast case with rollback.
AGENTDLP_GATEWAY_AGENT_DIRECT_ALLOW=

# 0 keeps host OUTPUT permissive after explicit allows. Set 1 only after a
# console-backed maintenance window confirms DNS, Docker and package operations.
AGENTDLP_GATEWAY_ENFORCE_OUTPUT=0
